{
  "name": "kshetra-landos",
  "version": "1.0.0",
  "private": true,
  "description": "Kshetra LandOS — AI Real Estate Operating System & UDCPR Plot Generator",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend",
    "postinstall": "npm install --prefix frontend",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
