# ─────────────────────────────────────────────
#  LandOS — .gitignore
#  Python + FastAPI (backend) | React (frontend)
# ─────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.manifest
*.spec

# ── Virtual Environments ──────────────────────
.venv/
venv/
env/
ENV/
.env/
.venv*/

# ── Environment Variables ─────────────────────
.env
.env.*
!.env.example

# ── FastAPI / Uvicorn & Uploads ─────────────
*.log
*.pid
backend/uploads/
backend/scratch_validation/uploads/

# ── Local databases & generated storage ──────
*.db
*.sqlite
*.sqlite3
storage/benchmarks/*/results/
storage/exports/*


# ── pytest ────────────────────────────────────
.pytest_cache/
.cache/
htmlcov/
.coverage
coverage.xml
nosetests.xml

# ── MyPy / Type Checkers ──────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Ruff / Linters ────────────────────────────
.ruff_cache/

# ── React / Node ──────────────────────────────
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.cache/
frontend/.parcel-cache/
*.local

# ── npm / yarn / pnpm ─────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS ────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
