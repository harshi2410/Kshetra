# LandOS Frontend Environment Configuration

# Google OAuth 2.0 Client ID for Web Applications
# Obtained from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Required Authorized JavaScript Origins:
#   - http://localhost:5173
#   - http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=

# LandOS FastAPI Backend Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
